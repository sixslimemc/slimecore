dispatch minecraft:storage[slimecore:hook] to struct Hook {
    start: (super::hook::rebuild::start::Hook | super::hook::load::start::Hook | super::hook::safe_mode::start::Hook),
    end: (super::hook::rebuild::end::Hook | super::hook::load::end::Hook | super::hook::safe_mode::end::Hook),
    load: (super::hook::call::pre::load::Hook | super::hook::call::post::load::Hook),
    entrypoint: (super::hook::call::pre::entrypoint::Hook | super::hook::call::post::entrypoint::Hook),
    preload_entrypoint: (super::hook::call::pre::preload_entrypoint::Hook | super::hook::call::post::preload_entrypoint::Hook),
    uninstall: (super::hook::call::pre::uninstall::Hook | super::hook::call::post::uninstall::Hook),
    disable: (super::hook::call::pre::disable::Hook | super::hook::call::post::disable::Hook),
    entrypoints: super::hook::load::entrypoints::Hook,
    loads: super::hook::load::loads::Hook,
    preload_entrypoints: super::hook::load::preload_entrypoints::Hook,
    safe_mode: (super::hook::call::pre::safe_mode::Hook | super::hook::call::post::safe_mode::Hook),
}